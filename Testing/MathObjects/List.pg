DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl','PGcourse.pl');

$x = random(1,10);
$y = random(1,10);
$z = random(1,10);

$list1 = List($x,$y,$z); 

BEGIN_PGML
- List in any order: [$x], [$y], [$z]: [_]{$list1}
- List with given order: [$x], [$y], [$z]: [_]{$list1->cmp(ordered => 1)}
END_PGML
ENDDOCUMENT();

