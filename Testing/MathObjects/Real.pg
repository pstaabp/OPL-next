DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');
Context('Numeric');

$base = random(2, 4);
$a    = non_zero_random(-4, 4);
$ans1 = Compute("$base^$a");

$b    = non_zero_random(-4, 4);
$ans2 = Compute("e^$b");

$c    = random(3, 10);
$d    = random(0,1,0.001);
$ans3 = Compute("$c*e^$d");

BEGIN_PGML
Evaluate the following expressions involving exponentials.
Leave your answer as a fraction or to at least 5 or 6 decimal places:

a) [` [$base]^{[$a]} =`]  [____]{$ans1}

b) [` e^{[$b]}=`]  [____]{$ans2}

c) [` [$c]*e^{[$d]}=`]  [____]{$ans3}


END_PGML

ENDDOCUMENT();
__DATA__
description: Evaluating exponential functions
library:
  subject: Algebra
  chapter: Exponential and logarithmic expressions and functions
  section: Exponential functions

testing: 
  - 
    seed: 1234
    answers:
      - '3^(-4)'
      - 'e^(-3)'
      - '4*e^(0.815)'
  - 
    seed: 123456
    answers: 
      - 0.1111111
      - 0.1353352832
      - 9.6110180035

