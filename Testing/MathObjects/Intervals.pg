DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context('Interval');

$a = random(-5,5);
$b = $a + random(2,8);

$interval1 = Interval("[$a,$b]");
$interval2 = Interval("[$a,$b)");
$interval3 = Interval("($a,$b]");
$interval4 = Interval("($a,$b)");

BEGIN_PGML
Enter the following intervals:

* [`` [$interval1]= ``] [_]{$interval1}
* [`` [$interval2]= ``] [_]{$interval2}
* [`` [$interval3]= ``] [_]{$interval3}
* [`` [$interval4]= ``] [_]{$interval4}
END_PGML

ENDDOCUMENT();

