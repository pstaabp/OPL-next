DOCUMENT();

loadMacros(
    'PGstandard.pl',     'PGML.pl',
    'PGchoicemacros.pl', 'extraAnswerEvaluators.pl',
    'PGcourse.pl'
);

Context('Interval');
$a   = non_zero_random(3, 9, 1);
$ans = Interval("(-inf,0]U[$a,inf)");

BEGIN_PGML
Let
[``` f(x) = \sqrt[4]{x^2 - [$a] x}. ```]
Use interval notation to indicate the domain of [` f(x) `].

Domain = [_]{$ans}{25}

[@ helpLink('interval notation') @]*

END_PGML

ENDDOCUMENT();

