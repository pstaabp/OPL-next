DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context('Interval');

$a = non_zero_random(-8, 8);

do {
    $r1 = non_zero_random(-8, 8);
    $r2 = non_zero_random(-8, 8);
    $c  = $r1 * $r2;
    $b  = -($r1 + $r2);
} until ($b != 0 and $b**2 != 1);

$num = Compute("x^2 + $b x + $c")->reduce;
$den = Compute("x -$r1 ")->reduce;

BEGIN_PGML

Let
[``` f(x) = \frac{[$num]}{[$den]} . ```]
Find the domain of [` f(x) `].

Domain = [_]{Interval("(-inf,$r1)U($r1,inf)")}{25}

[@ helpLink('interval notation') @]*
END_PGML

ENDDOCUMENT();

