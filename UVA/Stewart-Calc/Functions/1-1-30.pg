DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context('Interval');

$a = non_zero_random(-8, 8);
$b = non_zero_random(-8, 8);
$c = non_zero_random(-8, 8);
$d = non_zero_random(-8, 8);

$f = Compute("$a x^3 + $b x^2 + $c x + $d")->reduce;

$showPartialCorrectAnswers = 0;

BEGIN_PGML
Let [``` f(x) = [$f] ```]
Use interval notation to indicate the domain of [` f(x) `].

Domain = [_]{Interval('(-inf,inf)')}{25}

END_PGML

ENDDOCUMENT();

