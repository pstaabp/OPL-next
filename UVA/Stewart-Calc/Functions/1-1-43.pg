DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context('Numeric');
$a = non_zero_random(3, 9);

BEGIN_PGML
Find an expression for the function [`f(x)`] whose graph is given by the
bottom half of the parabola
[```  x + (y - [$a])^2 = 0.```]

[`f(x)`] = [_]{Compute("$a-sqrt(-x)")}{25}

END_PGML
ENDDOCUMENT();

