
DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

$a    = random(30, 90, 1);
$area = Compute("2x + 2*$a/x")->reduce;

BEGIN_PGML
Suppose that a rectangle has an area of [$a] square meters.  Express
the perimeter [`P`] as a function of the length [`x`] of one of
the sides.

[`P(x)`] = [_]{$area}{25}

END_PGML

ENDDOCUMENT();


