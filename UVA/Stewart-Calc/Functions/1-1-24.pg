DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context('Interval');

$a  = non_zero_random(-8, 8, 1);
$r1 = non_zero_random(-8, 8, 1);
$r2 = non_zero_random(-8, 8, 1);
$c  = $r1 * $r2;
$b  = -($r1 + $r2);

while ($b == 0 || $b**2 == 1) {
    $r1 = non_zero_random(-8, 8, 1);
    $r2 = non_zero_random(-8, 8, 1);
    $c  = $r1 * $r2;
    $b  = -($r1 + $r2);
}

$ans =
    $r1 == $r2  ? Interval("(-inf,$r1) U ($r1,inf)")
    : $r1 < $r2 ? Interval("(-inf,$r1) U ($r1,$r2) U ($r2, inf)")
    :             Interval("(-inf,$r2) U ($r2,$r1) U ($r1,inf)");

BEGIN_PGML

Let
[``` f(x) = \frac{x ? {[$a]}}{x^2 ? {[$b]} x ? {[$c]}}. ```]


Domain = [_]{$ans}{25}

[@ helpLink('interval notation') @]*
END_PGML

ENDDOCUMENT(); 

