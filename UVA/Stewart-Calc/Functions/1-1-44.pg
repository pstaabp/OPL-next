DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context('Numeric');

$a = random(3,   9);
$b = random(100, 129);

BEGIN_PGML
Find an expression for the function [`f(x)`] whose graph is given by the
top half of the circle
[```  (x-[$a])^2 + y^2 = [$b].```]

[`f(x)`] = [_]{Compute("sqrt($b - (x-$a)**2)")}{25}

END_PGML
ENDDOCUMENT();


