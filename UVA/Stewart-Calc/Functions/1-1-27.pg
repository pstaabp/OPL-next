DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

$a  = non_zero_random(3, 15, 2);
$b  = non_zero_random(2, 14, 2);
$e1 = random(3, 9, 2);

$ans = Interval("(-inf,inf)");

BEGIN_PGML
Let
[``` f(x) = \sqrt[[$e1]]{[$a] x^2 - [$b] x}. ```]
Use interval notation to indicate the domain of [` f(x) `].
  
Domain = [_]{$ans}{25}

[@ helpLink('interval notation') @]*

END_PGML

ENDDOCUMENT();

