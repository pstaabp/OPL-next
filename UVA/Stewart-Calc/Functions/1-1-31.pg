DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

$a = non_zero_random(-8, 8);
$f = Compute("sqrt(x + $a)")->reduce;

$showPartialCorrectAnswers = 0;

BEGIN_PGML
Let [``` f(x) = [$f]. ```]
Use interval notation to indicate the domain of [` f(x) `].

Domain = [_]{Interval("[-$a, inf)")}{25}

[@ helpLink('interval notation') @]*

END_PGML

ENDDOCUMENT();

