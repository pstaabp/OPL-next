DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context('Numeric');

$a   = random(1, 9, 2);
$b   = non_zero_random(-8, 8, 2);
$num = Formula("x-$a");
$den = Formula("x^2(x+$b)");
$f   = Formula("$num/$den")->reduce;

$ans = $b < 0 ? Compute('Infinity') : Compute('-Infinity');

BEGIN_PGML
Evaluate
[`` \lim_{x \to 0} [$f] ``]

Limit =  [_]{$ans}

[@  helpLink('limits')  @]*
END_PGML

ENDDOCUMENT(); 

__DATA__
