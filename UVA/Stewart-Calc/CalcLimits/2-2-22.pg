DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context('Numeric');

$a  = non_zero_random(-9, 9);
$lp = random(3, 7);

$ans = $a < 0 ? Compute("Infinity") : Compute("-Infinity");

BEGIN_PGML

Evaluate the following limit: 

[`` \displaystyle \lim_{x \rightarrow [$lp]^{-}} \frac{[$a]}{x - [$lp]} ``]
= [_]{$ans}{20}

[@  helpLink('limits')  @]*

END_PGML

ENDDOCUMENT();

