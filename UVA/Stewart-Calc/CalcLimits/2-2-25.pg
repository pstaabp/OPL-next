DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

$a = random(2, 8, 2);
$b = random(1, 9, 2);
$c = non_zero_random(-6, 6, 1);

Context('Numeric');

$showPartialCorrectAnswers = 1;

$a  = random(1, 9, 2);
$b  = non_zero_random(-8, 8, 2);
$mb = -$b;
$f  = Formula("(x-$a)/((x^2)(x+$b))")->reduce;

$ans = $mb > $a ? Compute("Infinity") : Compute("-Infinity");

BEGIN_PGML

Evaluate
[`` \lim_{x \to [$mb]^{+}} [$f] ``]

Limit =  [_]{$ans}

[@  helpLink('limits')  @]*

END_PGML

# ANS( $ans->cmp );

ENDDOCUMENT();

