DOCUMENT();

loadMacros(
    'PGstandard.pl',             'PGML.pl',
    'parserRadioMultiAnswer.pl', 'PGcourse.pl'
);

$a = random(2, 8, 2);
$b = random(1, 9, 2);
$c = non_zero_random(-6, 6, 1);

$showPartialCorrectAnswers = 1;

$a = random(2, 9, 1);

$rma = RadioMultiAnswer(
    [
        ['The limit does not exist'],
        [ 'The limit is \(L = \) %s', Compute("-Infinity") ],
    ],
    1
);

BEGIN_PGML
Evaluate
[``` L = \lim_{x \to [$a]^{+}} \ln(x-[$a]) ```]

[_]{$rma}

END_PGML

ENDDOCUMENT();

