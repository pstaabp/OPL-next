DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context('Numeric');

$a = random(2, 7);
$b = random(1, 7);
$c = non_zero_random(-1, 1, 2) * random(2, 4);

$showPartialCorrectAnswers = 1;

BEGIN_PGML
Let
[``` f(x) = \begin{cases}
            [$a], & x < [$b], \\
            [$c] x,  & x = [$b],\\
            10+x, & x > [$b].
            \end{cases} ```]
Evaluate each of the following:

a) [`\displaystyle{\lim_{x \rightarrow [$b]^{-}} f(x)}`] = [_]{$a}{10}

b) [`\displaystyle{\lim_{x \rightarrow [$b]^{+}} f(x)}`] = [_]{10+$b}{10}

c) [`f([$b]) = `] [_]{$c*$b}{10}

END_PGML

ENDDOCUMENT();        # This should be the last executable line in the problem.


