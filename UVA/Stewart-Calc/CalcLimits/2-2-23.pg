DOCUMENT();

loadMacros(
    'PGstandard.pl',             'PGML.pl',
    'parserRadioMultiAnswer.pl', 'PGcourse.pl'
);

Context('Numeric');

$a  = non_zero_random(-9, 9);
$lp = random(3, 7);
$e1 = random(4, 8);

$choice = ($e1 + 1) % 2;

$ans = $a < 0 ? Compute("-Infinity") : Compute("Infinity");

$rma = RadioMultiAnswer(
    [
        ['The limit does not exist'],
        [ 'The limit is \(L = \) %s', $ans ],
    ],
    $choice
);

BEGIN_PGML

Evaluate
[``` L = \lim_{x \to [$lp]} \frac{[$a]}{(x - [$lp])^{[$e1]}}. ```]

[_]{$rma}

END_PGML

ENDDOCUMENT(); 

